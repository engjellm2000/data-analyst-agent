# Local synthetic demo (default); set to cloud-demo only with Supabase/PostgreSQL configured.
APP_ENV=local
BI_AGENT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shopify app credentials from Shopify Dev Dashboard; keep secrets server-side.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://YOUR-APP.onrender.com/api/shopify/callback
SHOPIFY_WEBHOOK_BASE_URL=https://YOUR-APP.onrender.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_orders,read_products
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Optional error monitoring and protected Prometheus scrape endpoint.
SENTRY_DSN=
METRICS_BEARER_TOKEN=
